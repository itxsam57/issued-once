{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "functions": {
    "src/app/api/queue/design/route.ts": {
      "maxDuration": 300,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "issued-once-design",
          "retryAfterSeconds": 60
        }
      ]
    },
    "src/app/api/queue/notifications/route.ts": {
      "maxDuration": 120,
      "experimentalTriggers": [
        {
          "type": "queue/v2beta",
          "topic": "issued-once-notifications",
          "retryAfterSeconds": 60
        }
      ]
    }
  }
}
